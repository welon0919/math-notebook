---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { subjects } from '../data/subjects';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = '給高中到大一學生的數學入門筆記：代數、三角函數、微積分、線性代數的課程、公式與定理。',
} = Astro.props;
const fullTitle = title ? `${title}｜數學筆記本` : '數學筆記本';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* Runs before the body renders so CSS can set up JS-only initial states without a flash. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=Noto+Serif+TC:wght@700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-title" href={`${base}/`}>數學筆記本</a>
        <nav aria-label="科目">
          <ul>
            {
              subjects.map((s) => {
                const href = `${base}/${s.id}/`;
                const current = path.startsWith(href);
                return (
                  <li>
                    <a href={href} aria-current={current ? 'page' : undefined}>
                      {s.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
