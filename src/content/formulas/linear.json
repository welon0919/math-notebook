[
  {
    "name": "內積",
    "latex": "\\mathbf{u}\\cdot\\mathbf{v}=u_1v_1+u_2v_2+\\cdots+u_nv_n=|\\mathbf{u}|\\,|\\mathbf{v}|\\cos\\theta",
    "note": "$\\theta$ 為兩向量夾角；內積為 $0$ 表示兩向量垂直。"
  },
  {
    "name": "向量長度",
    "latex": "|\\mathbf{v}|=\\sqrt{\\mathbf{v}\\cdot\\mathbf{v}}=\\sqrt{v_1^2+v_2^2+\\cdots+v_n^2}"
  },
  {
    "name": "外積",
    "latex": "\\mathbf{u}\\times\\mathbf{v}=\\begin{vmatrix}\\mathbf{i}&\\mathbf{j}&\\mathbf{k}\\\\ u_1&u_2&u_3\\\\ v_1&v_2&v_3\\end{vmatrix}",
    "note": "只用於三維向量。結果同時垂直於 $\\mathbf{u}$、$\\mathbf{v}$，長度 $|\\mathbf{u}|\\,|\\mathbf{v}|\\sin\\theta$ 等於兩向量張成的平行四邊形面積。"
  },
  {
    "name": "投影",
    "latex": "\\operatorname{proj}_{\\mathbf{v}}\\mathbf{u}=\\dfrac{\\mathbf{u}\\cdot\\mathbf{v}}{\\mathbf{v}\\cdot\\mathbf{v}}\\,\\mathbf{v}",
    "note": "$\\mathbf{u}$ 在 $\\mathbf{v}$ 方向上的分量（正射影）。"
  },
  {
    "name": "二階行列式",
    "latex": "\\det\\begin{pmatrix}a&b\\\\ c&d\\end{pmatrix}=\\begin{vmatrix}a&b\\\\ c&d\\end{vmatrix}=ad-bc",
    "note": "絕對值等於兩個行向量張成的平行四邊形面積。"
  },
  {
    "name": "二階反矩陣",
    "latex": "\\begin{pmatrix}a&b\\\\ c&d\\end{pmatrix}^{-1}=\\dfrac{1}{ad-bc}\\begin{pmatrix}d&-b\\\\ -c&a\\end{pmatrix}",
    "note": "需 $ad-bc\\neq 0$：主對角線對調、副對角線變號，再除以行列式。"
  },
  {
    "name": "轉置與反矩陣",
    "latex": "(AB)^T=B^TA^T,\\qquad (AB)^{-1}=B^{-1}A^{-1},\\qquad (A^T)^{-1}=(A^{-1})^T",
    "note": "乘積的轉置與反矩陣，順序都要反過來。"
  },
  {
    "name": "行列式性質",
    "latex": "\\det(AB)=\\det A\\,\\det B,\\quad \\det(A^T)=\\det A,\\quad \\det(A^{-1})=\\dfrac{1}{\\det A},\\quad \\det(cA)=c^n\\det A",
    "note": "$A$、$B$ 為 $n$ 階方陣。交換兩列行列式變號；某列乘 $k$ 倍行列式也乘 $k$ 倍。"
  },
  {
    "name": "特徵方程式",
    "latex": "\\det(A-\\lambda I)=0",
    "note": "解出的 $\\lambda$ 是特徵值；再解 $(A-\\lambda I)\\mathbf{x}=\\mathbf{0}$ 的非零解，就是對應的特徵向量。"
  },
  {
    "name": "跡與行列式",
    "latex": "\\operatorname{tr}A=\\lambda_1+\\lambda_2+\\cdots+\\lambda_n,\\qquad \\det A=\\lambda_1\\lambda_2\\cdots\\lambda_n",
    "note": "跡是主對角線元素和。特徵值依重數計算（可能是複數）。"
  }
]
