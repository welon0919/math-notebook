---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SubjectTabs from '../../components/SubjectTabs.astro';
import FormulaList from '../../components/FormulaList.astro';
import TheoremList from '../../components/TheoremList.astro';
import { subjects, type Subject } from '../../data/subjects';
import { renderMathText } from '../../lib/math';
import { lessonHref, loadLessons, unitGroups } from '../../lib/lessons';

export const getStaticPaths = (() =>
  subjects.map((subject) => ({ params: { subject: subject.id }, props: { subject } }))) satisfies GetStaticPaths;

interface Props {
  subject: Subject;
}

const { subject } = Astro.props;
const { lessons, items } = await loadLessons();
const groups = unitGroups(subject.id, lessons);
const formulas = items.formulas.filter((e) => e.data.subject === subject.id);
const theorems = items.theorems.filter((e) => e.data.subject === subject.id);

const tabs = [
  { id: 'lessons', label: '課程' },
  { id: 'formulas', label: '公式' },
  { id: 'theorems', label: '定理' },
];
---

<Base title={subject.name} description={`${subject.name}入門：${subject.description}。課程、常用公式與重要定理。`}>
  <h1>{subject.name}</h1>
  <p>{subject.description}</p>

  <SubjectTabs tabs={tabs} label={`${subject.name}內容`}>
    <section id="lessons" class="tab-panel">
      <h2 class="visually-hidden">課程</h2>
      {
        groups.map((group) => (
          <details class="unit" open>
            <summary>
              <h3>
                <span class="unit-number">第 {group.number} 單元</span>
                {group.unit.name}
              </h3>
            </summary>
            <ol class="lesson-list">
              {group.lessons.map((lesson) => (
                <li>
                  <a href={lessonHref(lesson)}>{lesson.data.title}</a>
                  <p class="lesson-summary" set:html={renderMathText(lesson.data.summary)} />
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </section>

    <section id="formulas" class="tab-panel">
      <h2 class="visually-hidden">公式</h2>
      <FormulaList formulas={formulas} />
    </section>

    <section id="theorems" class="tab-panel">
      <h2 class="visually-hidden">定理</h2>
      <TheoremList theorems={theorems} />
    </section>
  </SubjectTabs>
</Base>
