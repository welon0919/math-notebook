---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SubjectTabs from '../../components/SubjectTabs.astro';
import FormulaList from '../../components/FormulaList.astro';
import TheoremList from '../../components/TheoremList.astro';
import { subjects, type Subject } from '../../data/subjects';

export const getStaticPaths = (() =>
  subjects.map((subject) => ({ params: { subject: subject.id }, props: { subject } }))) satisfies GetStaticPaths;

interface Props {
  subject: Subject;
}

const { subject } = Astro.props;
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const lessons = (await getCollection('lessons', (e) => e.data.subject === subject.id)).sort(byOrder);
const formulas = (await getCollection('formulas', (e) => e.data.subject === subject.id)).sort(byOrder);
const theorems = (await getCollection('theorems', (e) => e.data.subject === subject.id)).sort(byOrder);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tabs = [
  { id: 'lessons', label: '課程' },
  { id: 'formulas', label: '公式' },
  { id: 'theorems', label: '定理' },
];
---

<Base title={subject.name}>
  <h1>{subject.name}</h1>
  <p>{subject.description}</p>

  <SubjectTabs tabs={tabs} label={`${subject.name}內容`}>
    <section id="lessons" class="tab-panel">
      <h2 class="visually-hidden">課程</h2>
      <ol class="lesson-list">
        {
          lessons.map((lesson) => (
            <li>
              <a href={`${base}/${lesson.id}/`}>{lesson.data.title}</a>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="formulas" class="tab-panel">
      <h2 class="visually-hidden">公式</h2>
      <FormulaList formulas={formulas} />
    </section>

    <section id="theorems" class="tab-panel">
      <h2 class="visually-hidden">定理</h2>
      <TheoremList theorems={theorems} />
    </section>
  </SubjectTabs>
</Base>
